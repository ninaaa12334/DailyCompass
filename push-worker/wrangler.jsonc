{
  // Day Compass push service: stores each device's notification address and upcoming reminder
  // times, and sends due reminders every minute — so notifications arrive even when the site is closed.
  "name": "day-compass-push",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "triggers": { "crons": ["* * * * *"] },
  "d1_databases": [
    { "binding": "DB", "database_name": "day-compass-push", "database_id": "6c040136-ceb8-455d-a460-a02034895a9e" }
  ],
  "vars": {
    // Sites allowed to talk to this service.
    "ALLOWED_ORIGINS": "https://daily-compass1.vercel.app,http://127.0.0.1:8080,http://localhost:8080",
    "VAPID_SUBJECT": "https://daily-compass1.vercel.app",
    "PUBLIC_URL": "https://day-compass-push.day-compass-push.workers.dev",
    // Where Google sends people back. Goes through the website's own address (vercel.json forwards it here),
    // so Google only ever shows daily-compass1.vercel.app.
    "GOOGLE_REDIRECT_URI": "https://day-compass-push.day-compass-push.workers.dev/google/callback",
    // Google Calendar (read-only). The client secret is a Cloudflare secret, never committed.
    "GOOGLE_CLIENT_ID": "88571627712-80ju191ofue37chvtar32l29gg1k7hcr.apps.googleusercontent.com",
    // Used only to check who is signed in (public key, safe to commit).
    "SUPABASE_URL": "https://ffjjvkbojuetcdmpqapx.supabase.co",
    "SUPABASE_KEY": "sb_publishable_uL03_LEg7r7fkqc0FkQGRg_1GzUSsVk"
  }
  // Secrets (never committed): VAPID_PUBLIC_KEY, VAPID_PRIVATE_KEY, TOKEN_KEY, GOOGLE_CLIENT_SECRET
}
