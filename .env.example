# Copy to .env. Never commit real keys.
APP_ORIGIN=http://127.0.0.1:8080
HOST=127.0.0.1
PORT=8080
DATABASE_PATH=data/compass.sqlite
# Development generates data/token.key if blank. Production requires an explicit key.
TOKEN_ENCRYPTION_KEY=
# Optional real AI. Choose a model supporting Responses structured outputs.
# API billing is separate; leave both blank until ready.
OPENAI_API_KEY=
OPENAI_MODEL=
# Google OAuth Web application client, Calendar and Gmail APIs enabled.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Authorized redirect: http://127.0.0.1:8080/api/google/callback
# Run node scripts/generate-push-keys.mjs, then copy its output here.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# Deployment requires NODE_ENV=production, HTTPS APP_ORIGIN, a permanent encryption
# key and protected persistent disk. Do not expose this development server directly.
